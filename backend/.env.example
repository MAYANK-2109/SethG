NODE_ENV=development
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sethg_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT secrets — change before deploying!
JWT_ACCESS_SECRET=sethg_access_secret_change_in_prod
JWT_REFRESH_SECRET=sethg_refresh_secret_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
